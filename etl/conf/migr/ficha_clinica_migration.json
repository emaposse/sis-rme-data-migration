          "encounter_filter_obs_concept_list": "@estadio_oms_actual_concept_id,@estado_mdc_concept_id,@lactante_concept_id,@data_da_ultima_mestruacao_concept_id,@data_da_gravidez_concept_id,@planeamento_familiar_concept_id,@adesao_ao_tratamento_id",
          "location_list": "@location_to_migrate",
          "dst_location_id": "@dst_location_id",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "6",
          "order_id_transformer": "NULL_VALUE_TRANSFORMER()",
          "grouped_concept_list": "@modo_dispensa_estado_mdc_concept_id,@estado_do_mdc_estado_mdc_concept_id",
          "extra_condition": "${included_patient_extra_condition}"
        },
        "override": [
          {
            "path": "dstConf.mapping",
            "type": "DELETE_ON_LIST",
            "match": {
              "dstField": "uuid"
            }
          }
        ]
      },
      "childItemConf": [
        {
          "srcConf": {
            "tableName": "obs",
            "tableAlias": "ficha_clinica_obs_gravida_src_ds",
            "joinExtraCondition": "concept_id in (@gravida_concept_id)"
          },
          "dstConf": [
            {
              "tableName": "obs",
              "tableAlias": "ficha_clinica_obs_gravida_dst_ds",
              "preferredDataSource": [
                "ficha_clinica_obs_gravida_src_ds"
              ],
              "ignorableFields": [
                "obs_group_id",
                "previous_version",
                "order_group_id"
              ],
              "mapping": [
                {
                  "dstField": "concept_id",
                  "relationshipResolutionStrategy": "SKIP",
                  "transformer": "MAPPING_TRANSFORMER(sesp_sisrme_metadata_mapping,sesp_value,sisrme_value,on_missing:USE_INPUT,input:concept_id,extra_condition:mapping_group=\"concept\")"
                },
                {
                  "srcField": "value_coded",
                  "dstField": "value_coded",
                  "relationshipResolutionStrategy": "SKIP"
                },
                {
                  "srcField": "ficha_clinica_encounter_dst_ds.location_id",
                  "dstField": "location_id"
                },
                {
                  "srcField": "ficha_clinica_encounter_dst_ds.encounter_id",
                  "dstField": "encounter_id"
                },
                {
                  "srcField": "ficha_clinica_encounter_dst_ds.patient_id",
                  "dstField": "person_id"
                }
              ]
            }
          ]
        },
        {
