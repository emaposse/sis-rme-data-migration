{
  "originAppLocationCode": "${location_name}",
  "etlRootDirectory": "${etl_root_dir}",
  "syncStageSchema": "data_migration_stage_area",
  "childConfigFilePath": "${etl_root_dir}/conf/migr/ficha_resumo_migration.json",
  "templatesDir": "templates/migr/*.json",
  "verifyRecordAfterCreate": false,
  "mainConnInfo": {
    "dataBaseUserName": "${srcUserName}",
    "dataBaseUserPassword": "${srcUserPassword}",
    "connectionURI": "${srcConnectionURI}",
    "driveClassName": "${driveClassName}",
    "isolationLevel": "${connectionIsolationLevel}",
    "defaultAutoCommit": "${autoCommit}"
  },
  "srcConnInfo": {
    "dataBaseUserName": "${srcUserName}",
    "dataBaseUserPassword": "${srcUserPassword}",
    "connectionURI": "${srcConnectionURI}",
    "driveClassName": "${driveClassName}",
    "isolationLevel": "${connectionIsolationLevel}",
    "maxActiveConnections": "${maxActiveConnections}",
    "maxIdleConnections": "${maxIdleConnections}",
    "minIdleConnections": "${minIdleConnections}",
    "defaultAutoCommit": "${autoCommit}"
  },
  "dstConnInfo": {
    "dataBaseUserName": "${dstUserName}",
    "dataBaseUserPassword": "${dstUserPassword}",
    "connectionURI": "${dstConnectionURI}",
    "driveClassName": "${driveClassName}",
    "databaseSchemaPath": "sis-rme-empty-db.sql",
    "isolationLevel": "${connectionIsolationLevel}",
    "maxActiveConnections": "${maxActiveConnections}",
    "maxIdleConnections": "${maxIdleConnections}",
    "minIdleConnections": "${minIdleConnections}",
    "defaultAutoCommit": "${autoCommit}"
  },
  "validators": [
    {
      "name": "dst_location_is_smi_department",
      "connectionToUse": "dstConnInfo",
      "value": {
        "name": "smi_destination_location_id",
        "dataType": "int",
        "transformer": "FAST_SQL_TRANSFORMER(select service_concept_id from ${dst_db}.clinical_service where location_id = ${smi_destination_location_id} and service_concept_id = 1872)"
      },
      "rule": {
        "type": "EQUALS",
        "expectedValue": 1872
      },
      "message": "The provided destination location ${smi_destination_location_id} does not represent a valid smi department",
      "phase": "BEFORE_LOAD",
      "behavior": "ABORT_PROCESS"
    },
    {
      "name": "dst_ccr_service",
      "connectionToUse": "dstConnInfo",
      "value": {
        "name": "dst_ccr_service_id",
        "dataType": "int",
        "transformer": "FAST_SQL_TRANSFORMER(select service_concept_id from ${dst_db}.clinical_service where clinical_service_id = ${dst_ccr_service_id} and location_id = ${smi_destination_location_id})"
      },
      "rule": {
        "type": "EQUALS",
        "expectedValue": 1872
      },
      "message": "The provided dst_ccr_service_id ${dst_ccr_service_id} does not represent a valid ccr service with department ${smi_destination_location_id}",
      "phase": "BEFORE_LOAD",
      "behavior": "ABORT_PROCESS"
    }
  ],
  "dataModel": {
    "template": {
      "name": "data_model_for_${dataModelType}_objects"
    }
  },
  "ignoreAllStartupScripts": "${ignoreAllStartupScripts}",
  "ignorableStartupScripts": [
    "delete_duplicated_encounters.sql",
    "delete_invalid_patient_identifiers.sql",
    "move_sync_msg_delete_operation.sql",
    "sync_data_structure.sql"
  ],
  "operations": [
    {
      "template": {
        "name": "etl_operations_for_${dataModelType}_datamodel"
      }
    }
  ],
  "params": {
    "dst_db": "${dst_db}",
    "location_to_migrate": "${src_location_list}",
    "dst_location_id": "${smi_destination_location_id}",
    "ccr_service_id": "${dst_ccr_service_id}",
    "default_provider_id": "1",
    "src_encounter_type_id": "93",
    "nome_da_mae_concept_id": "1477",
    "nome_do_pai_concept_id": "1485",
    "local_trabalho_mae_concept_id": "1834",
    "local_trabalho_pai_concept_id": "1835",
    "confidente_concept_id": "2033",
    "confidente_telefone": "6224",
    "confidente_aceita_visita_concept_id": "2071",
    "motivo_de_consulta_crianca_em_risco": "1874",
    "peso_kg_concept_id": "5089",
    "altura_cm_concept_id": "5090",
    "peso_estatura_concept_id": "23756",
    "perimetro_craniano": "165479",
    "idade_gestacional_ao_parto": "6400",
