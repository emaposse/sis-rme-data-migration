    "candidiase_oral_concept_id": "5334",
    "adenomegalia_concept_id": "1877",
    "secrecao_no_ouvido_concept_id": "1878",
    "desenvolvimento_psicomotor_concept_id": "1882",
    "pcr_exame_teste_concept_id": "1030",
    "teste_rapido_hiv_concept_id": "1040",
    "aleitamento_materno_exclusivo_concept_id": "5526",
    "aleitamento_artificial_concept_id": "5254",
    "aleitamento_misto_concept_id": "6046",
    "agregado_familiar_adultos": "1853",
