          "srcConf": {
            "tableName": "encounter",
            "tableAlias": "encounter_for_enrollment_src_ds",
            "onConflict": "UPDATE_EXISTING",
            "extraQueryDataSource": [
              {
                "name": "enrollment_src_ds",
                "script": "ccr_program_enroll.sql",
                "required": true,
                "onMultipleSrcObjectsFound": "USE_FIRST"
              }
            ]
          },
          "dstConf": [
            {
              "tableName": "patient_program",
              "tableAlias": "patient_program_dst_ds",
              "ignorableFields": [
                "idart",
                "date_completed",
                "outcome_concept_id"
              ],
              "mapping": [
                {
                  "dstField": "uuid",
                  "transformer": "UUID_ON_DEMAND_TRANSFORMER(table_name:patient_program,lookup_condition:patient_id = ccr_inscricao_encounter_dst_ds.patient_id and program_id = enrollment_src_ds.program_id and voided = 0 limit 1)"
                }
              ]
            }
          ],
          "childItemConf": [
            {
              "relatedParentDstConfName": "patient_program_dst_ds",
              "srcConf": {
                "tableName": "patient",
                "joinFields": [
                  {
                    "srcField": "patient_id",
                    "dstField": "patient_id"
                  }
                ]
              },
              "dstConf": [
                {
                  "tableName": "patient_state",
                  "preferredDataSource": [
                    "patient_program_dst_ds"
                  ],
                  "ignorableFields": [
                    "end_date",
                    "form_namespace_and_path",
                    "encounter_id"
                  ],
                  "mapping": [
                    {
                      "srcField": "state",
                      "dstField": "state",
                      "relationshipResolutionStrategy": "SKIP"
                    },
                    {
                      "dstField": "uuid",
                      "transformer": "UUID_ON_DEMAND_TRANSFORMER(table_name:patient_state,skip_relationship_resolution_for_fields:state,table_alias:onDemandPs,lookup_condition:onDemandPs.patient_state_id = (select ps.patient_state_id from patient_program pp inner join patient_state ps on ps.patient_program_id = pp.patient_program_id and  pp.patient_id = ccr_inscricao_encounter_dst_ds.patient_id and pp.program_id = enrollment_src_ds.program_id and pp.voided = 0 and ps.state = enrollment_src_ds.state))"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
