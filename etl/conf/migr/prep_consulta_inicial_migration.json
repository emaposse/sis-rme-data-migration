{
  "originAppLocationCode": "${location_name}",
  "etlRootDirectory": "${etl_root_dir}",
  "syncStageSchema": "data_migration_stage_area",
  "childConfigFilePath": "${etl_root_dir}/conf/migr/prep_consulta_seguimento_migration.json",
  "templatesDir": "templates/migr/*.json",
  "mainConnInfo": {
    "dataBaseUserName": "${srcUserName}",
    "dataBaseUserPassword": "${srcUserPassword}",
    "connectionURI": "${srcConnectionURI}",
    "driveClassName": "${driveClassName}",
    "isolationLevel": "${connectionIsolationLevel}",
    "defaultAutoCommit": "${autoCommit}"
  },
  "srcConnInfo": {
    "dataBaseUserName": "${srcUserName}",
    "dataBaseUserPassword": "${srcUserPassword}",
    "connectionURI": "${srcConnectionURI}",
    "driveClassName": "${driveClassName}",
    "isolationLevel": "${connectionIsolationLevel}",
    "maxActiveConnections": "${maxActiveConnections}",
    "maxIdleConnections": "${maxIdleConnections}",
    "minIdleConnections": "${minIdleConnections}",
    "defaultAutoCommit": "${autoCommit}"
  },
  "dstConnInfo": {
    "dataBaseUserName": "${dstUserName}",
    "dataBaseUserPassword": "${dstUserPassword}",
    "connectionURI": "${dstConnectionURI}",
    "driveClassName": "${driveClassName}",
    "databaseSchemaPath": "sis-rme-empty-db.sql",
    "isolationLevel": "${connectionIsolationLevel}",
    "maxActiveConnections": "${maxActiveConnections}",
    "maxIdleConnections": "${maxIdleConnections}",
    "minIdleConnections": "${minIdleConnections}",
    "defaultAutoCommit": "${autoCommit}"
  },
  "validators": [
    {
      "name": "dst_location_is_smi_department",
      "connectionToUse": "dstConnInfo",
      "value": {
        "name": "hiv_destination_location_id",
        "dataType": "int",
        "transformer": "FAST_SQL_TRANSFORMER(select service_concept_id from ${dst_db}.clinical_service where location_id = ${hiv_destination_location_id} and service_concept_id = 6274)"
      },
      "rule": {
        "type": "EQUALS",
        "expectedValue": 6274
      },
      "message": "The provided destination location ${hiv_destination_location_id} does not represent a valid hiv  department",
      "phase": "BEFORE_LOAD",
      "behavior": "ABORT_PROCESS"
    },
    {
      "name": "dst_tarv_service",
      "connectionToUse": "dstConnInfo",
      "value": {
        "name": "dst_prep_service_id",
        "dataType": "int",
        "transformer": "FAST_SQL_TRANSFORMER(select service_concept_id from ${dst_db}.clinical_service where clinical_service_id = ${dst_prep_service_id} and location_id = ${hiv_destination_location_id})"
      },
      "rule": {
        "type": "EQUALS",
        "expectedValue": 23894
      },
      "message": "The provided dst_prep_service_id ${dst_prep_service_id} does not represent a valid prep service with department ${hiv_destination_location_id}",
      "phase": "BEFORE_LOAD",
      "behavior": "ABORT_PROCESS"
    }
  ],
  "dataModel": {
    "template": {
      "name": "data_model_for_${dataModelType}_objects"
    }
  },
  "ignoreAllStartupScripts": "${ignoreAllStartupScripts}",
  "ignorableStartupScripts": [
    "delete_duplicated_encounters.sql",
    "delete_invalid_patient_identifiers.sql",
    "move_sync_msg_delete_operation.sql",
    "sync_data_structure.sql"
  ],
  "operations": [
    {
      "template": {
        "name": "etl_operations_for_${dataModelType}_datamodel"
      }
    }
  ],
  "params": {
    "dst_db": "${dst_db}",
    "location_to_migrate": "${src_location_list}",
    "dst_location_id": "${hiv_destination_location_id}",
    "prep_service_id": "${dst_prep_service_id}",
    "admission_reason_other_concept_id": "202208",
    "default_provider_id": "1",
    "default_medical_speciality_concept_id": "233552",
    "src_encounter_type_id": "80",
    "keypop_concept_id": "23703",
    "keypop_other_concept_id": "5622",
    "creatina_concept_id": "790",
    "vdrl_concept_id": "299",
    "hepatite_b_test_concept_id": "1322",
    "its_screening_concept_list": "6258",
    "its_diagnose_concept_id": "1080",
    "rastreio_hiv": "1040",
    "prep_initial_status_concept_id": "165296",
    "prep_type_concept_id": "165516",
    "prep_regimen_concept_id": "165213",
    "prep_next_consultation_date_concept_id": "165228",
    "prep_drug_quantity_concept_id": "165217",
    "prep_contant_type_concept_id": "6309",
    "prep_permanance_state_concept_id": "165292",
    "prep_target_group_concept_id": "165196",
    "prep_regime_concept_id": "165213",
    "prep_prescription_order_type_id": "12",
    "prep_prescription_encounter_type_id": "149",
    "data_resultado_negativo_hiv_concept_id": "165194",
    "lactante_concept_id": "6332",
    "gestante_concept_id": "1982",
    "data_inicio_prep_person_attribute_type_id": "117",
    "data_inicio_prep_concept_id": "165211"
  },
  "defaultSourceTable": "person",
  "defaultExceptionBehavior": "${defaultExceptionBehavior}",
  "defaultInconsistencyBehavior": "${defaultInconsistencyBehavior}",
  "stageRecordIssueBehavior": "${stageRecordIssueBehavior}",
  "relatedEtlSrcTables": [
    "person",
    "patient",
    "users",
    "provider",
    "location"
  ],
  "etlItemConfiguration": [
    {
      "disabled": true,
      "srcConf": {
        "tableName": "patient"
      },
      "dstConf": [
        {
          "tableName": "patient",
          "ignorableFields": [
            "dde_sync_pending"
          ]
        }
      ]
    },
    {
      "template": {
        "name": "encounter_joined_with_obs_to_encounter_and_obs",
        "parameters": {
          "visit_type_id": "48",
          "program_id": "${prep_program_id}",
          "concept_list": "@lactante_concept_id,@gestante_concept_id",
          "encounter_filter_obs_concept_list": "@lactante_concept_id,@gestante_concept_id,@prep_initial_status_concept_id,@prep_type_concept_id,@data_inicio_prep_concept_id",
          "location_list": "@location_to_migrate",
          "dst_location_id": "@dst_location_id",
          "aliases_prefix": "prep_data",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "81",
          "grouped_concept_list": "0",
          "order_id_transformer": "NULL_VALUE_TRANSFORMER()",
          "extra_condition": "${included_patient_extra_condition}"
        },
        "override": [
          {
            "path": "dstConf.mapping",
            "type": "DELETE_ON_LIST",
            "match": {
              "dstField": "uuid"
            }
          }
        ]
      },
      "childItemConf": [
        {
          "template": {
            "name": "estado_sorologico_hiv",
            "parameters": {
              "aliases_prefix": "prep_data",
              "estado_sorologico_concept_id": "@data_resultado_negativo_hiv_concept_id",
              "hiv_test_result_field": "664",
              "hiv_test_resulte_date_field": "value_datetime"
            }
          }
        },
        {
          "srcConf": {
            "tableName": "encounter",
            "tableAlias": "encounter_for_enrollment_src_ds",
            "onConflict": "UPDATE_EXISTING",
            "extraQueryDataSource": [
              {
                "name": "enrollment_src_ds",
                "script": "prep_program_enroll.sql",
                "required": true,
                "onMultipleSrcObjectsFound": "USE_FIRST"
              }
            ]
          },
          "dstConf": [
            {
              "tableName": "patient_program",
              "tableAlias": "patient_program_dst_ds",
              "ignorableFields": [
                "idart",
                "date_completed",
                "outcome_concept_id"
              ],
              "mapping": [
                {
                  "dstField": "uuid",
                  "transformer": "UUID_ON_DEMAND_TRANSFORMER(table_name:patient_program,lookup_condition:patient_id = prep_data_encounter_dst_ds.patient_id and program_id = enrollment_src_ds.program_id and voided = 0)"
                }
              ]
            }
          ],
          "childItemConf": [
            {
              "relatedParentDstConfName": "patient_program_dst_ds",
              "template": {
                "name": "on_demand_encounter",
                "parameters": {
                  "visit_type_id": "48",
                  "program_id": "${prep_program_id}",
                  "dst_encounter_type_id": "220",
                  "aliases_prefix": "incricao",
                  "dst_location_id": "@dst_location_id",
                  "patient_id": "encounter_for_enrollment_src_ds.patient_id",
                  "encounter_datetime": "enrollment_src_ds.date_enrolled",
                  "creator": "patient_program_dst_ds.creator"
                }
              }
            },
            {
              "relatedParentDstConfName": "patient_program_dst_ds",
              "srcConf": {
                "tableName": "patient",
                "joinFields": [
                  {
                    "srcField": "patient_id",
                    "dstField": "patient_id"
                  }
                ]
              },
              "dstConf": [
                {
                  "tableName": "patient_state",
                  "preferredDataSource": [
                    "patient_program_dst_ds"
                  ],
                  "ignorableFields": [
                    "end_date",
                    "form_namespace_and_path",
                    "encounter_id"
                  ],
                  "mapping": [
                    {
                      "srcField": "state",
                      "dstField": "state",
                      "relationshipResolutionStrategy": "SKIP"
                    },
                    {
                      "dstField": "uuid",
                      "transformer": "UUID_ON_DEMAND_TRANSFORMER(table_name:patient_state,skip_relationship_resolution_for_fields:state,table_alias:onDemandPs,lookup_condition:onDemandPs.patient_state_id = (select ps.patient_state_id from patient_program pp inner join patient_state ps on ps.patient_program_id = pp.patient_program_id and  pp.patient_id = prep_data_encounter_dst_ds.patient_id and pp.program_id = enrollment_src_ds.program_id and pp.voided = 0 and ps.state = enrollment_src_ds.state))"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "template": {
            "name": "obs_next_consultation_date_to_appointment",
            "parameters": {
              "parent_aliases_prefix": "prep_data",
              "next_consultation_date_concept_id": "@prep_next_consultation_date_concept_id",
              "extra_condition": "${included_person_extra_condition}",
              "service_id":"@prep_service_id"
            }
          }
        }
      ]
    },
    {
      "template": {
        "name": "obs_joined_with_encounter_to_person_attribute",
        "parameters": {
          "aliases_prefix": "data_inicio_prep",
          "concept_list": "@data_inicio_prep_concept_id",
          "location_list": "@location_to_migrate",
          "src_encounter_type_id": "@src_encounter_type_id",
          "person_attribute_type_id": "@data_inicio_prep_person_attribute_type_id",
          "value_field": "data_inicio_prep_obs_src_ds.value_datetime",
          "value_field_is_date": true,
          "transformer": "",
          "extra_condition": "${included_person_extra_condition}"
        }
      }
    },
    {
      "srcConf": {
        "tableName": "obs",
        "tableAlias": "data_inicio_prep_from_situacao_inicial_prep_obs_src_ds",
        "extraConditionForExtract": "concept_id = @prep_initial_status_concept_id and value_coded = 1256 and voided = 0",
        "auxExtractTable": [
          {
            "tableName": "encounter",
            "tableAlias": "encounter_for_situacao_inicial_prep_src_ds",
            "joinExtraCondition": "encounter_type = 80 and not exists (select * from obs data_inicio_prep_obs where data_inicio_prep_obs.concept_id = @data_inicio_prep_concept_id and data_inicio_prep_obs.encounter_id = encounter_for_situacao_inicial_prep_src_ds.encounter_id and  data_inicio_prep_obs.voided = 0)"
          }
        ]
      },
      "dstConf": [
        {
          "template": {
            "name": "dst_person_attribute",
            "parameters": {
              "aliases_prefix": "data_inicio_prep_using_situacao_prep",
              "person_attribute_type_id": "117",
              "value": "data_inicio_prep_from_situacao_inicial_prep_obs_src_ds.obs_datetime",
              "uuid_transformer": "UUID_ON_DEMAND_TRANSFORMER(table_name:person_attribute,lookup_condition:person_attribute_type_id=117 and person_id = data_inicio_prep_from_situacao_inicial_prep_obs_src_ds.person_id)",
              "uuid_src_field": ""
            },
            "override": [
              {
                "path": "mapping",
                "type": "ADD_TO_LIST",
                "value": {
                  "srcField": "data_inicio_prep_from_situacao_inicial_prep_obs_src_ds.person_id",
                  "dstField": "person_id"
                }
              }
            ]
          },
          "onMissingRequiredSrcObject": "MARK_RECORD_AS_FAILED",
          "onConflict": "UPDATE_EXISTING"
        }
      ]
    },
    {
      "template": {
        "name": "encounter_joined_with_obs_target_groups",
        "parameters": {
          "aliases_prefix": "prep_target_group",
          "concept_list": "@prep_target_group_concept_id",
          "location_list": "@location_to_migrate",
          "src_encounter_type_id": "@src_encounter_type_id",
          "person_attribute_type_id": "114",
          "extra_condition": "${included_person_extra_condition}"
        }
      }
    },
    {
      "template": {
        "name": "encounter_joined_with_obs_to_key_pop",
        "parameters": {
          "aliases_prefix": "prep_key_pop",
          "concept_list": "@keypop_concept_id",
          "location_list": "@location_to_migrate",
          "src_encounter_type_id": "@src_encounter_type_id",
          "person_attribute_type_id": "92",
          "extra_condition": "${included_person_extra_condition}"
        }
      }
    },
    {
      "template": {
        "name": "encounter_joined_with_obs_to_lab_result",
        "parameters": {
          "visit_type_id": "48",
          "program_id": "${prep_program_id}",
          "concept_list": "@creatina_concept_id,@vdrl_concept_id,@hepatite_b_test_concept_id",
          "location_list": "@location_to_migrate",
          "dst_location_id": "@dst_location_id",
          "aliases_prefix": "lab_result",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "117",
          "dst_order_encounter_type_id": "116",
          "order_type_id": 2,
          "extra_condition": "${included_patient_extra_condition} and encounter_id not in (160936)"
        }
      }
    },
    {
      "template": {
        "name": "encounter_joined_with_obs_to_encounter_and_vital_signs",
        "parameters": {
          "visit_type_id": "48",
          "program_id": "${prep_program_id}",
          "aliases_prefix": "vital_signs",
          "location_list": "@location_to_migrate",
          "dst_location_id": "@dst_location_id",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "113",
          "extra_condition": "${included_patient_extra_condition}"
        }
      }
    },
    {
      "template": {
        "name": "encounter_joined_with_obs_to_encounter_and_obs",
        "parameters": {
          "visit_type_id": "48",
          "program_id": "${prep_program_id}",
          "concept_list": "@its_screening_concept_list",
          "encounter_filter_obs_concept_list": "@its_screening_concept_list",
          "location_list": "@location_to_migrate",
          "dst_location_id": "@dst_location_id",
          "aliases_prefix": "rastreio_its",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "180",
          "grouped_concept_list": "0",
          "order_id_transformer": "NULL_VALUE_TRANSFORMER()",
          "extra_condition": "${included_patient_extra_condition}"
        }
      }
    },
    {
      "template": {
        "name": "encounter_joined_with_obs_to_encounter_and_conditions",
        "parameters": {
          "visit_type_id": "48",
          "program_id": "${prep_program_id}",
          "concept_list": "@its_diagnose_concept_id",
          "location_list": "@location_to_migrate",
          "dst_location_id": "@dst_location_id",
          "aliases_prefix": "its_diagnose",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "108",
          "condition_src_field": "its_diagnose_obs_src_ds.value_coded",
          "extra_condition": "${included_patient_extra_condition}"
        }
      }
    },
    {
      "template": {
        "name": "encounter_joined_with_obs_to_prep_prescription",
        "parameters": {
          "visit_type_id": "48",
          "program_id": "${prep_program_id}",
          "concept_list": "@prep_regime_concept_id",
          "location_list": "@location_to_migrate",
          "aliases_prefix": "prescription",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "@prep_prescription_encounter_type_id",
          "dst_location_id": "@dst_location_id",
          "order_type_id": "@prep_prescription_order_type_id",
          "prescription_header_script": "prep_prescription_header_data_ds.sql",
          "prescription_item_script": "prep_prescription_item_data_ds.sql",
          "encounter_uuid": "UUID_ON_DEMAND_TRANSFORMER(table_name:encounter,lookup_condition:encounter_type=@prep_prescription_encounter_type_id and patient_id = prescription_encounter_src_ds.patient_id and encounter_datetime = prescription_encounter_src_ds.encounter_datetime)",
          "extra_condition": "${included_patient_extra_condition} and 1 = (select 1 as value from obs o where o.encounter_id = encounter_id and o.concept_id = @prep_regime_concept_id and o.value_coded in (165214,165215,165613) limit 1)",
          "main_prescription_obs_condition": "concept_id = @prep_regime_concept_id and voided = 0",
          "estado_prep_concept_id": "234492"
        }
      }
    },
    {
      "template": {
        "name": "encounter_joined_with_obs_to_encounter_and_obs",
        "parameters": {
          "visit_type_id": "48",
          "program_id": "${prep_program_id}",
          "concept_list": "@prep_contant_type_concept_id",
          "encounter_filter_obs_concept_list": "@prep_contant_type_concept_id",
          "location_list": "@location_to_migrate",
          "dst_location_id": "@dst_location_id",
          "aliases_prefix": "meio_contacto",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "220",
          "grouped_concept_list": "0",
          "order_id_transformer": "NULL_VALUE_TRANSFORMER()",
          "extra_condition": "${included_patient_extra_condition}"
        }
      }
    },
    {
      "disabled": true,
      "template": {
        "name": "encounter_joined_with_obs_to_encounter_and_obs",
        "parameters": {
          "visit_type_id": "48",
          "program_id": "${prep_program_id}",
          "aliases_prefix": "consulta_inicial",
          "concept_list": "@prep_permanance_state_concept_id",
          "encounter_filter_obs_concept_list": "@prep_permanance_state_concept_id",
          "location_list": "@location_to_migrate",
          "dst_location_id": "@dst_location_id",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "147",
          "order_id_transformer": "NULL_VALUE_TRANSFORMER()",
          "grouped_concept_list": "",
          "extra_condition": "${included_patient_extra_condition}"
        },
        "override": [
          {
            "path": "dstConf.mapping",
            "type": "UPDATE_ON_LIST",
            "match": {
              "dstField": "uuid"
            },
            "value": {
              "dstField": "uuid",
              "transformer": "FAST_SQL_TRANSFORMER(name:initial_consultation_query,query:select uuid from encounter where encounter_type=53 and patient_id=consulta_inicial_encounter_src_ds.patient_id and voided = 0 limit 1)"
            }
          }
        ]
      }
    }
  ]
}
