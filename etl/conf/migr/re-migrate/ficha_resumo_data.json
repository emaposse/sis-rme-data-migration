  "etlItemConfiguration": [
    {
      "template": {
        "name": "encounter_joined_with_obs_to_encounter_and_obs",
        "parameters": {
          "visit_type_id": "48",
          "program_id": "${tarv_program_id}",
          "concept_list": "@clinical_groupping_concept_id,@clinical_non_groupped_concept_id",
          "encounter_filter_obs_concept_list": "@clinical_groupping_concept_id,@clinical_non_groupped_concept_id",
          "location_list": "@location_to_migrate",
          "dst_location_id": "@dst_location_id",
          "aliases_prefix": "consulta_inicial",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "147",
          "grouped_concept_list": "@clinical_groupped_concept_id",
          "order_id_transformer": "NULL_VALUE_TRANSFORMER()",
          "extra_condition": "${included_patient_extra_condition} and not exists (select * from ${dst_db}.encounter dstEnc inner join ${dst_db}.person dstPerson on dstEnc.encounter_type = 147 and dstEnc.patient_id = dstPerson.person_id inner join person srcPerson on srcPerson.uuid = dstPerson.uuid where srcPerson.person_id = consulta_inicial_encounter_src_ds.patient_id)"
        },
        "override": [
          {
            "path": "dstConf.mapping",
            "type": "DELETE_ON_LIST",
            "match": {
              "dstField": "uuid"
            }
          }
        ]
      },
      "childItemConf": [
        {
          "srcConf": {
            "tableName": "obs",
            "tableAlias": "consulta_inicial_obs_gravida_e_sector_src_ds",
            "joinExtraCondition": "concept_id in (@clinical_transformed_concept_id) and ${included_person_extra_condition}"
          },
          "dstConf": [
            {
              "tableName": "obs",
              "tableAlias": "consulta_inicial_obs_gravida_e_sector_dst_ds",
              "preferredDataSource": [
                "consulta_inicial_obs_gravida_e_sector_src_ds"
              ],
              "ignorableFields": [
                "obs_group_id",
                "previous_version",
                "order_group_id"
              ],
              "mapping": [
                {
                  "dstField": "concept_id",
                  "relationshipResolutionStrategy": "SKIP",
                  "transformer": "MAPPING_TRANSFORMER(sesp_sisrme_metadata_mapping,sesp_value,sisrme_value,on_missing:USE_INPUT,input:concept_id,extra_condition:mapping_group=\"concept\")"
                },
                {
                  "srcField": "value_coded",
                  "dstField": "value_coded",
                  "relationshipResolutionStrategy": "SKIP"
                },
                {
                  "srcField": "consulta_inicial_encounter_dst_ds.location_id",
                  "dstField": "location_id"
                },
                {
                  "srcField": "consulta_inicial_encounter_dst_ds.encounter_id",
                  "dstField": "encounter_id"
                },
                {
                  "srcField": "consulta_inicial_encounter_dst_ds.patient_id",
                  "dstField": "person_id"
                }
              ]
            }
          ]
        },
        {
          "srcConf": {
            "tableName": "obs",
            "tableAlias": "consulta_inicial_data_inicio_pre_tarv_src_ds",
            "joinExtraCondition": "voided = 0 and concept_id in (@data_inicio_pre_tarv_concept_id) and ${included_person_extra_condition}"
          },
          "dstConf": [
            {
              "tableName": "obs",
              "tableAlias": "consulta_inicial_data_inicio_pre_tarv_dst_ds",
              "preferredDataSource": [
                "consulta_inicial_data_inicio_pre_tarv_src_ds"
              ],
              "ignorableFields": [
                "obs_group_id",
                "previous_version",
                "order_group_id"
              ],
              "mapping": [
                {
                  "srcValue": "233948",
                  "dstField": "concept_id",
                  "relationshipResolutionStrategy": "SKIP"
                },
                {
                  "srcField": "comments",
                  "dstField": "value_text"
                },
                {
                  "srcField": "consulta_inicial_encounter_dst_ds.location_id",
                  "dstField": "location_id"
                },
                {
                  "srcField": "consulta_inicial_encounter_dst_ds.encounter_id",
                  "dstField": "encounter_id"
                },
                {
                  "srcField": "consulta_inicial_encounter_dst_ds.patient_id",
                  "dstField": "person_id"
                },
                {
                  "dstField": "uuid",
                  "transformer": "FAST_SQL_TRANSFORMER(select uuid())"
                }
              ]
            }
          ]
        },
        {
          "template": {
            "name": "obs_to_efeitos_colaterais",
            "parameters": {
              "parent_aliases_prefix": "consulta_inicial"
            }
          }
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "obs",
        "tableAlias": "hiv_test_",
        "extraConditionForExtract": "${included_person_extra_condition} and hiv_test_.voided = 0 and (hiv_test_.concept_id = @hiv_rapid_test_concept_id or hiv_test_.concept_id = @tipo_test_hiv_concept_id) and 1 = (select 1 from encounter hiv_test_encounter where hiv_test_encounter.encounter_type = @src_encounter_type_id and hiv_test_encounter.voided = 0 and hiv_test_encounter.location_id in (@location_to_migrate) and  hiv_test_.encounter_id = hiv_test_encounter.encounter_id  limit 1)"
      },
      "dstConf": [
        {
          "tableName": "obs",
          "disabled": true,
          "ignorableFields": [
            "order_group_id"
          ]
        }
      ],
      "childItemConf": [
        {
          "applyCondition": "value_coded = @hiv_rapid_test_concept_id or concept_id = @hiv_rapid_test_concept_id",
          "template": {
            "name": "encounter_joined_with_obs_to_lab_result",
            "parameters": {
              "visit_type_id": "48",
              "program_id": "${tarv_program_id}",
              "aliases_prefix": "hiv_rapid_test",
              "concept_list": "@hiv_rapid_test_concept_id",
              "location_list": "@location_to_migrate",
              "dst_location_id": "@dst_location_id",
              "src_encounter_type_id": "@src_encounter_type_id",
              "dst_encounter_type_id": "117",
              "dst_order_encounter_type_id": "169",
              "order_type_id": 22,
              "extra_condition": "${included_patient_extra_condition}"
            }
          }
        },
        {
          "applyCondition": "value_coded = @hiv_pcr_test_concept_id",
          "template": {
            "name": "encounter_joined_with_obs_to_lab_result",
            "parameters": {
              "visit_type_id": "48",
              "program_id": "${tarv_program_id}",
              "aliases_prefix": "hiv_pcr_test",
              "concept_list": "@hiv_pcr_test_concept_id",
              "location_list": "@location_to_migrate",
              "dst_location_id": "@dst_location_id",
              "src_encounter_type_id": "@src_encounter_type_id",
              "dst_encounter_type_id": "117",
              "dst_order_encounter_type_id": "116",
              "order_type_id": 2,
              "extra_condition": "${included_patient_extra_condition}"
            }
          }
        }
      ]
    },
    {
      "template": {
        "name": "obs_to_person_attribute",
        "parameters": {
          "aliases_prefix": "profissao",
          "concept_list": "@obs_profissao",
          "location_list": "@location_to_migrate",
          "person_attribute_type_id": "55",
          "src_encounter_type_id": "@src_encounter_type_id",
          "value": "profissao_obs_src_ds.value_text",
          "value_field_is_date": false,
          "extra_condition": "${included_person_extra_condition}"
        }
      }
    },
    {
      "template": {
        "name": "obs_to_person_attribute",
        "parameters": {
          "aliases_prefix": "escolaridade",
          "concept_list": "@obs_escolaridade",
          "location_list": "@location_to_migrate",
          "person_attribute_type_id": "60",
          "src_encounter_type_id": "@src_encounter_type_id",
          "value": "escolaridade_obs_src_ds.value_coded",
          "value_field_is_date": false,
          "extra_condition": "${included_person_extra_condition}"
        }
      }
    },
    {
      "template": {
        "name": "obs_to_person_complex_attribute",
        "parameters": {
          "aliases_prefix": "contact_situation",
          "concept_list": "@obs_contact_situation_concept_id",
          "location_list": "@location_to_migrate",
          "src_encounter_type_id": "@src_encounter_type_id",
          "person_attribute_type_id": "110",
          "extra_condition": "${included_person_extra_condition} and encounter_id = 41065"
        }
      },
      "childItemConf": [
        {
          "template": {
            "name": "child_obs_to_person_attribute",
            "parameters": {
              "aliases_prefix": "confidente",
              "parent_aliases_prefix": "contact_situation",
              "person_attribute_type_id": "110"
            }
          }
        },
        {
          "srcConf": {
            "template": {
              "name": "src_obs_joined_with_grouping_obs",
              "parameters": {
                "aliases_prefix": "contact_situation_child",
                "concept_list": "@obs_contact_situation_all"
              }
            }
          },
          "dstConf": [
            {
              "template": {
                "name": "dst_person_complex_attribute_detail_from_obs",
                "parameters": {
                  "src_aliases_prefix": "contact_situation_child",
                  "dst_aliases_prefix": "confidente_name",
                  "src_object_condition": "concept_id = @obs_contact_situation_nome",
                  "attribute_key": "contact_situation.name.text",
                  "attribute_value": "contact_situation_child_obs_src_ds.value_text"
                }
              }
            },
            {
              "template": {
                "name": "dst_person_complex_attribute_detail_from_obs",
                "parameters": {
                  "src_aliases_prefix": "contact_situation_child",
                  "dst_aliases_prefix": "confidente_parentesco",
                  "src_object_condition": "concept_id = @obs_contact_situation_parentesco",
                  "attribute_key": "contact_situation.relationship_type.concept.concept_id",
                  "attribute_value": "contact_situation_child_obs_src_ds.value_coded"
                }
              }
            },
            {
              "template": {
                "name": "dst_person_complex_attribute_detail_from_obs",
                "parameters": {
                  "src_aliases_prefix": "contact_situation_child",
                  "dst_aliases_prefix": "confidente_idade",
                  "src_object_condition": "concept_id = @obs_contact_situation_idade",
                  "attribute_key": "contact_situation.age.numeric",
                  "attribute_value": "contact_situation_child_obs_src_ds.value_numeric"
                }
              }
            },
            {
              "template": {
                "name": "dst_person_complex_attribute_detail_from_obs",
                "parameters": {
                  "src_aliases_prefix": "contact_situation_child",
                  "dst_aliases_prefix": "confidente_nid",
                  "src_object_condition": "concept_id = @obs_contact_situation_nid",
                  "attribute_key": "contact_situation.nid.text",
                  "attribute_value": "contact_situation_child_obs_src_ds.value_text"
                }
              }
            },
            {
              "template": {
                "name": "dst_person_complex_attribute_detail_from_obs",
                "parameters": {
                  "src_aliases_prefix": "contact_situation_child",
                  "dst_aliases_prefix": "confidente_hiv_status",
                  "src_object_condition": "concept_id = @obs_contact_situation_hiv_test",
                  "attribute_key": "contact_situation.hiv_status.concept.concept_id",
                  "attribute_value": "contact_situation_child_obs_src_ds.value_coded"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "template": {
        "name": "encounter_joined_with_obs_to_person_complex_attribute_and_person_attribute",
        "parameters": {
          "aliases_prefix": "contacto_referencia",
          "concept_list": "@obs_confidente_nome,@obs_confidente_parantesco,@obs_confidente_telefone,@obs_confidente_endereco",
          "location_list": "@location_to_migrate",
          "src_encounter_type_id": "@src_encounter_type_id",
          "person_attribute_type_id": "109",
          "extra_condition": "${included_patient_extra_condition}"
        }
      },
      "childItemConf": [
        {
          "srcConf": {
            "tableName": "obs",
            "tableAlias": "contacto_referencia_inner_obs_src_ds",
            "joinExtraCondition": "concept_id in (@obs_confidente_nome,@obs_confidente_parantesco,@obs_confidente_telefone,@obs_confidente_endereco) and voided = 0 and obs_group_id is null",
            "comments": "Os dados do confidente nao estao agrupados e como o conceito para obs_confidente_parantesco ocorre tambem na situacao familiar,entao aqui consideramos obs_group_id is null",
            "joinFields": [
              {
                "srcField": "encounter_id",
                "dstField": "encounter_id"
              }
            ]
          },
          "dstConf": [
            {
              "template": {
                "name": "dst_person_complex_attribute_detail_from_obs",
                "parameters": {
                  "src_aliases_prefix": "contacto_referencia_inner",
                  "dst_aliases_prefix": "contacto_referencia_nome",
                  "src_object_condition": "concept_id = @obs_confidente_nome",
                  "attribute_key": "sisrme.reference_contact_information.full_name.text",
                  "attribute_value": "contacto_referencia_inner_obs_src_ds.value_text"
                }
              }
            },
            {
              "template": {
                "name": "dst_person_complex_attribute_detail_from_obs",
                "parameters": {
                  "src_aliases_prefix": "contacto_referencia_inner",
                  "dst_aliases_prefix": "contacto_referencia_parantesco",
                  "src_object_condition": "concept_id = @obs_confidente_parantesco",
                  "attribute_key": "sisrme.reference_contact_information.relationship_type.concept.concept_id",
                  "attribute_value": "contacto_referencia_inner_obs_src_ds.value_coded"
                }
              }
            },
            {
              "template": {
                "name": "dst_person_complex_attribute_detail_from_obs",
                "parameters": {
                  "src_aliases_prefix": "contacto_referencia_inner",
                  "dst_aliases_prefix": "contacto_referencia_type",
                  "src_object_condition": "concept_id = @obs_confidente_nome",
                  "attribute_key": "sisrme.reference_contact_information.type_of_contact_person.concept.concept_id",
                  "attribute_value": "FAST_SQL_TRANSFORMER(SELECT 2033)"
                }
              }
            },
            {
              "template": {
                "name": "dst_person_complex_attribute_detail_from_obs",
                "parameters": {
                  "src_aliases_prefix": "contacto_referencia_inner",
                  "dst_aliases_prefix": "contacto_referencia_endereco",
                  "src_object_condition": "concept_id = @obs_confidente_endereco",
                  "attribute_key": "sisrme.reference_contact_information.address.text",
                  "attribute_value": "contacto_referencia_inner_obs_src_ds.value_text"
                }
              }
            },
            {
              "template": {
                "name": "dst_person_complex_attribute_detail_from_obs",
                "parameters": {
                  "src_aliases_prefix": "contacto_referencia_inner",
                  "dst_aliases_prefix": "contacto_referencia_telefone",
