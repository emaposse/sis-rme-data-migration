          "location_list": "@location_to_migrate",
          "dst_location_id": "@dst_location_id",
          "aliases_prefix": "seguimento_rastreio_its",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "180",
          "grouped_concept_list": "0",
          "order_id_transformer": "NULL_VALUE_TRANSFORMER()",
          "extra_condition": "${included_patient_extra_condition}"
        }
      }
    },
    {
      "template": {
        "name": "encounter_joined_with_obs_to_encounter_and_obs",
        "parameters": {
          "visit_type_id": "48",
          "program_id": "${prep_program_id}",
          "concept_list": "0",
          "encounter_filter_obs_concept_list": "@hiv_rapid_test_concept_id",
          "location_list": "@location_to_migrate",
          "dst_location_id": "@dst_location_id",
          "aliases_prefix": "test_rapido_hiv",
          "src_encounter_type_id": "81",
          "dst_encounter_type_id": "@dst_rastreio_encounter_type_id",
          "grouped_concept_list": "0",
          "order_id_transformer": "NULL_VALUE_TRANSFORMER()",
          "extra_condition": "${included_patient_extra_condition}"
        }
      },
      "childItemConf": [
        {
          "template": {
            "name": "estado_sorologico_hiv",
            "parameters": {
              "aliases_prefix": "test_rapido_hiv",
              "estado_sorologico_concept_id": "@hiv_rapid_test_concept_id",
              "hiv_test_result_field": "value_coded",
              "hiv_test_resulte_date_field": "obs_datetime"
            }
          }
        }
      ]
    },
    {
      "template": {
        "name": "encounter_joined_with_obs_to_prep_prescription",
        "parameters": {
          "visit_type_id": "48",
          "program_id": "${prep_program_id}",
          "concept_list": "@prep_regime_concept_id",
          "location_list": "@location_to_migrate",
          "aliases_prefix": "seguimento_prescription",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "@prep_prescription_encounter_type_id",
          "dst_location_id": "@dst_location_id",
          "order_type_id": "@prep_prescription_order_type_id",
          "prescription_header_script": "prep_prescription_header_data_ds.sql",
          "prescription_item_script": "prep_prescription_item_data_ds.sql",
          "encounter_uuid": "UUID_ON_DEMAND_TRANSFORMER(table_name:encounter,lookup_condition:encounter_type=@prep_prescription_encounter_type_id and patient_id = prescription_encounter_src_ds.patient_id and encounter_datetime = prescription_encounter_src_ds.encounter_datetime)",
          "extra_condition": "${included_patient_extra_condition} and 1 = (select 1 from obs o where o.encounter_id = encounter_id and o.concept_id = @prep_regime_concept_id and o.value_coded in (165214,165215,165613) limit 1)",
          "main_prescription_obs_condition": "concept_id = @prep_regime_concept_id and voided = 0",
          "estado_prep_concept_id": "234493"
        }
      }
    },
    {
      "disabled": true,
      "template": {
        "name": "encounter_joined_with_obs_to_encounter_and_obs",
        "parameters": {
          "visit_type_id": "48",
          "program_id": "${prep_program_id}",
          "aliases_prefix": "seguimento_consulta_inicial",
          "concept_list": "@prep_permanance_state_concept_id",
          "encounter_filter_obs_concept_list": "@prep_permanance_state_concept_id",
          "location_list": "@location_to_migrate",
          "dst_location_id": "@dst_location_id",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "147",
          "order_id_transformer": "NULL_VALUE_TRANSFORMER()",
          "grouped_concept_list": "",
          "extra_condition": "${included_patient_extra_condition}"
        },
        "override": [
          {
            "path": "dstConf.mapping",
            "type": "UPDATE_ON_LIST",
            "match": {
              "dstField": "uuid"
            },
            "value": {
              "dstField": "uuid",
              "transformer": "FAST_SQL_TRANSFORMER(name:initial_consultation_query,query:select uuid from encounter where encounter_type=53 and patient_id=consulta_inicial_encounter_src_ds.patient_id and voided = 0 limit 1)"
            }
          }
        ]
      }
    }
  ]
}
