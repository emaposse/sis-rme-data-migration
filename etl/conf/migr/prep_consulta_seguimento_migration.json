    {
      "template": {
        "name": "encounter_joined_with_obs_to_lab_result",
        "parameters": {
          "visit_type_id": "48",
          "program_id": "${prep_program_id}",
          "concept_list": "@creatina_concept_id",
          "location_list": "@location_to_migrate",
          "dst_location_id": "@dst_location_id",
          "aliases_prefix": "seguimento_lab_result",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "117",
          "dst_order_encounter_type_id": "116",
          "order_type_id": 2,
          "extra_condition": "${included_patient_extra_condition}"
        }
      }
    },
