{
  "originAppLocationCode": "${location_name}",
  "etlRootDirectory": "${etl_root_dir}",
  "syncStageSchema": "data_migration_stage_area",
  "childConfigFilePath": "${etl_root_dir}/conf/migr/ccr_consulta_inicial_migration.json",
  "templatesDir": "templates/migr/*.json",
  "mainConnInfo": {
    "dataBaseUserName": "${srcUserName}",
    "dataBaseUserPassword": "${srcUserPassword}",
    "connectionURI": "${srcConnectionURI}",
    "driveClassName": "${driveClassName}",
    "isolationLevel": "${connectionIsolationLevel}",
    "defaultAutoCommit": "${autoCommit}"
  },
  "srcConnInfo": {
    "dataBaseUserName": "${srcUserName}",
    "dataBaseUserPassword": "${srcUserPassword}",
    "connectionURI": "${srcConnectionURI}",
    "driveClassName": "${driveClassName}",
    "isolationLevel": "${connectionIsolationLevel}",
    "maxActiveConnections": "${maxActiveConnections}",
    "maxIdleConnections": "${maxIdleConnections}",
    "minIdleConnections": "${minIdleConnections}",
    "defaultAutoCommit": "${autoCommit}"
  },
  "dstConnInfo": {
    "dataBaseUserName": "${dstUserName}",
    "dataBaseUserPassword": "${dstUserPassword}",
    "connectionURI": "${dstConnectionURI}",
    "driveClassName": "${driveClassName}",
    "databaseSchemaPath": "sis-rme-empty-db.sql",
    "isolationLevel": "${connectionIsolationLevel}",
    "maxActiveConnections": "${maxActiveConnections}",
    "maxIdleConnections": "${maxIdleConnections}",
    "minIdleConnections": "${minIdleConnections}",
    "defaultAutoCommit": "${autoCommit}"
  },
  "validators": [
    {
      "name": "dst_location_is_smi_department",
      "connectionToUse": "dstConnInfo",
      "value": {
        "name": "hiv_destination_location_id",
        "dataType": "int",
        "transformer": "FAST_SQL_TRANSFORMER(select service_concept_id from ${dst_db}.clinical_service where location_id = ${hiv_destination_location_id} and service_concept_id = 6274)"
      },
      "rule": {
        "type": "EQUALS",
        "expectedValue": 6274
      },
      "message": "The provided destination location ${hiv_destination_location_id} does not represent a valid hiv  department",
      "phase": "BEFORE_LOAD",
      "behavior": "ABORT_PROCESS"
    },
    {
      "name": "dst_tarv_service",
      "connectionToUse": "dstConnInfo",
      "value": {
        "name": "dst_prep_service_id",
        "dataType": "int",
        "transformer": "FAST_SQL_TRANSFORMER(select service_concept_id from ${dst_db}.clinical_service where clinical_service_id = ${dst_prep_service_id} and location_id = ${hiv_destination_location_id})"
      },
      "rule": {
        "type": "EQUALS",
        "expectedValue": 23894
      },
      "message": "The provided dst_prep_service_id ${dst_prep_service_id} does not represent a valid prep service with department ${hiv_destination_location_id}",
      "phase": "BEFORE_LOAD",
      "behavior": "ABORT_PROCESS"
    }
  ],
  "dataModel": {
    "template": {
      "name": "data_model_for_${dataModelType}_objects"
    }
  },
  "ignoreAllStartupScripts": "${ignoreAllStartupScripts}",
  "ignorableStartupScripts": [
    "delete_duplicated_encounters.sql",
    "delete_invalid_patient_identifiers.sql",
    "move_sync_msg_delete_operation.sql",
    "sync_data_structure.sql"
  ],
  "operations": [
    {
      "template": {
        "name": "etl_operations_for_${dataModelType}_datamodel"
      }
    }
  ],
  "params": {
    "dst_db": "${dst_db}",
    "location_to_migrate": "${src_location_list}",
    "dst_location_id": "${hiv_destination_location_id}",
    "prep_service_id": "${dst_prep_service_id}",
    "admission_reason_other_concept_id": "202208",
    "default_provider_id": "1",
    "default_medical_speciality_concept_id": "233552",
    "src_encounter_type_id": "81",
    "dst_rastreio_encounter_type_id": "184",
    "keypop_concept_id": "23703",
    "keypop_other_concept_id": "5622",
    "pp1_concept_id": "6317",
    "creatina_concept_id": "790",
    "cretina_test_request_concept_id": "165220",
    "vdrl_concept_id": "299",
    "hepatite_b_test_concept_id": "1322",
    "its_screening_concept_list": "6258",
    "its_diagnose_concept_id": "1080",
    "hiv_rapid_test_concept_id": "1040",
    "prep_initial_status_concept_id": "165296",
    "prep_type_concept_id": "165516",
    "prep_regimen_concept_id": "165213",
    "prep_next_consultation_date_concept_id": "165228",
    "prep_drug_quantity_concept_id": "165217",
    "prep_contant_type_concept_id": "6309",
    "prep_permanance_state_concept_id": "165292",
    "prep_target_group_concept_id": "165196",
    "prep_aconselhamento_adesao_concept_id": "165221",
    "prep_aconselhamento_reducao_risco_concept_id": "165222",
    "prep_regime_concept_id": "165213",
    "prep_prescription_order_type_id": "12",
    "prep_prescription_encounter_type_id": "149",
    "prep_key_pop_lubrificantes": "23771",
    "prep_key_pop_preservativos": "6317",
    "estado_mdc_concept_id": "165323",
    "modo_dispensa_estado_mdc_concept_id": "165174",
    "estado_do_mdc_estado_mdc_concept_id": "165322",
    "estado_da_mulher_concept_id": "165223",
    "lactante_concept_id": "6332",
    "gestante_concept_id": "1982"
  },
  "defaultSourceTable": "person",
  "defaultExceptionBehavior": "${defaultExceptionBehavior}",
  "defaultInconsistencyBehavior": "${defaultInconsistencyBehavior}",
  "stageRecordIssueBehavior": "${stageRecordIssueBehavior}",
  "relatedEtlSrcTables": [
    "person",
    "patient",
    "users",
    "provider",
    "location"
  ],
  "etlItemConfiguration": [
    {
      "template": {
        "name": "encounter_joined_with_obs_to_encounter_and_obs",
        "parameters": {
          "visit_type_id": "48",
          "program_id": "${prep_program_id}",
          "concept_list": "@estado_mdc_concept_id,@prep_aconselhamento_adesao_concept_id,@prep_aconselhamento_reducao_risco_concept_id,@pp1_concept_id",
          "encounter_filter_obs_concept_list": "@estado_mdc_concept_id,@prep_aconselhamento_adesao_concept_id,@prep_aconselhamento_reducao_risco_concept_id,@pp1_concept_id,@estado_da_mulher_concept_id,@prep_type_concept_id",
          "location_list": "@location_to_migrate",
          "dst_location_id": "@dst_location_id",
          "aliases_prefix": "seguimento_prep_data",
          "src_encounter_type_id": "@src_encounter_type_id",
          "dst_encounter_type_id": "81",
          "grouped_concept_list": "@modo_dispensa_estado_mdc_concept_id,@estado_do_mdc_estado_mdc_concept_id",
          "order_id_transformer": "NULL_VALUE_TRANSFORMER()",
          "extra_condition": "${included_patient_extra_condition}"
        },
        "override": [
          {
            "path": "dstConf.mapping",
            "type": "DELETE_ON_LIST",
            "match": {
              "dstField": "uuid"
            }
          }
        ]
      },
      "childItemConf": [
        {
          "template": {
            "name": "obs_next_consultation_date_to_appointment",
            "parameters": {
              "parent_aliases_prefix": "seguimento_prep_data",
              "next_consultation_date_concept_id": "@prep_next_consultation_date_concept_id",
              "service_id": "@prep_service_id",
              "extra_condition": "${included_person_extra_condition}"
            }
          }
        },
        {
          "srcConf": {
            "tableName": "obs",
            "tableAlias": "keypop_oferta_lub_obs_src_ds",
            "joinExtraCondition": "concept_id in (@prep_key_pop_lubrificantes, @prep_key_pop_preservativos) and value_coded = 1065 and voided = 0"
          },
          "dstConf": [
            {
              "tableName": "obs",
              "tableAlias": "keypop_oferta_lub_obs_dst_ds",
              "onConflict": "UPDATE_EXISTING",
              "allowDuplicateDestinationMappings": true,
              "preferredDataSource": [
                "keypop_oferta_lub_obs_src_ds"
              ],
              "ignorableFields": [
                "previous_version",
                "order_group_id"
              ],
              "mapping": [
                {
                  "srcValue": "@dst_location_id",
                  "dstField": "location_id",
                  "relationshipResolutionStrategy": "VALIDATE_ONLY"
                },
                {
                  "srcValue": "@prep_key_pop_lubrificantes",
                  "dstField": "concept_id",
                  "relationshipResolutionStrategy": "VALIDATE_ONLY"
                },
                {
                  "srcValue": "232851",
                  "dstField": "value_coded",
                  "relationshipResolutionStrategy": "VALIDATE_ONLY",
                  "applyCondition": "keypop_oferta_lub_obs_src_ds.concept_id = @prep_key_pop_lubrificantes"
                },
                {
                  "srcValue": "190",
                  "dstField": "value_coded",
                  "relationshipResolutionStrategy": "VALIDATE_ONLY",
                  "applyCondition": "keypop_oferta_lub_obs_src_ds.concept_id = @prep_key_pop_preservativos"
                },
                {
                  "srcField": "seguimento_prep_data_encounter_dst_ds.encounter_id",
                  "dstField": "encounter_id"
                }
              ]
            }
          ]
        },
        {
          "srcConf": {
            "tableName": "obs",
            "tableAlias": "estado_mulher_obs_src_ds",
            "joinExtraCondition": "concept_id = @estado_da_mulher_concept_id"
          },
          "dstConf": [
            {
              "tableName": "obs",
              "tableAlias": "estado_mulher_gravida_obs_dst_ds",
              "applyCondition": "estado_mulher_obs_src_ds.value_coded = @gestante_concept_id",
              "onConflict": "UPDATE_EXISTING",
              "ignorableFields": [
                "order_group_id"
              ],
              "mapping": [
                {
                  "dstField": "concept_id",
                  "relationshipResolutionStrategy": "SKIP",
                  "transformer": "MAPPING_TRANSFORMER(sesp_sisrme_metadata_mapping,sesp_value,sisrme_value,on_missing:USE_INPUT,input:@gestante_concept_id,extra_condition:mapping_group=\"concept\")"
                },
                {
                  "srcValue": "1065",
                  "dstField": "value_coded"
                }
              ]
            },
            {
              "tableName": "obs",
              "tableAlias": "estado_mulher_lactante_obs_dst_ds",
              "applyCondition": "estado_mulher_obs_src_ds.value_coded = @lactante_concept_id",
              "onConflict": "UPDATE_EXISTING",
              "ignorableFields": [
                "order_group_id"
              ],
              "mapping": [
                {
                  "dstField": "concept_id",
                  "relationshipResolutionStrategy": "SKIP",
                  "transformer": "MAPPING_TRANSFORMER(sesp_sisrme_metadata_mapping,sesp_value,sisrme_value,on_missing:USE_INPUT,input:@lactante_concept_id,extra_condition:mapping_group=\"concept\")"
                },
                {
                  "srcValue": "1065",
                  "dstField": "value_coded"
                }
              ]
            },
            {
              "tableName": "obs",
              "tableAlias": "estado_mulher_nao_gravida_obs_dst_ds",
              "applyCondition": "estado_mulher_obs_src_ds.value_coded = 1066",
              "onConflict": "UPDATE_EXISTING",
              "ignorableFields": [
                "order_group_id"
              ],
              "mapping": [
                {
                  "dstField": "concept_id",
                  "relationshipResolutionStrategy": "SKIP",
                  "transformer": "MAPPING_TRANSFORMER(sesp_sisrme_metadata_mapping,sesp_value,sisrme_value,on_missing:USE_INPUT,input:@gestante_concept_id,extra_condition:mapping_group=\"concept\")"
                },
                {
                  "srcValue": "1066",
                  "dstField": "value_coded"
                }
              ]
            },
            {
              "tableName": "obs",
              "tableAlias": "estado_mulher_nao_lactante_obs_dst_ds",
              "applyCondition": "estado_mulher_obs_src_ds.value_coded = 1066",
              "onConflict": "UPDATE_EXISTING",
              "ignorableFields": [
                "order_group_id"
              ],
              "mapping": [
                {
                  "dstField": "concept_id",
                  "relationshipResolutionStrategy": "SKIP",
                  "transformer": "MAPPING_TRANSFORMER(sesp_sisrme_metadata_mapping,sesp_value,sisrme_value,on_missing:USE_INPUT,input:@lactante_concept_id,extra_condition:mapping_group=\"concept\")"
                },
                {
                  "srcValue": "1066",
                  "dstField": "value_coded"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "template": {
        "name": "encounter_joined_with_obs_to_key_pop",
        "parameters": {
          "aliases_prefix": "seguimento_prep_key_pop",
          "concept_list": "@keypop_concept_id",
