{
  "name": "child_obs_to_person_attribute",
  "parameters": [
    "aliases_prefix",
    "parent_aliases_prefix",
    "person_attribute_type_id"
  ],
  "template": {
    "srcConf": {
      "tableName": "obs",
      "tableAlias": "${aliases_prefix}_obs_src_ds",
      "joinFields": [
        {
          "srcField": "obs_id",
          "dstField": "obs_id"
        }
      ]
    },
    "dstConf": [
      {
        "tableName": "person_attribute",
        "tableAlias": "${aliases_prefix}_person_attribute_dst_ds",
        "mapping": [
          {
            "srcValue": "${person_attribute_type_id}",
            "dstField": "person_attribute_type_id"
          },
          {
            "srcField": "person_complex_attribute_id",
            "dstField": "value"
          },
          {
            "srcField": "${aliases_prefix}_obs_src_ds.uuid",
            "dstField": "uuid"
          }
        ],
        "ignorableFields": [
          "changed_by",
          "date_changed"
        ]
      }
    ]
  }
}
