{
  "name": "encounter_joined_with_obs_to_lab_request",
  "extends": {
    "name": "encounter_joined_with_obs_to_encounter",
    "parameters": {
      "aliases_prefix": "${aliases_prefix}",
      "patient_id": "0",
      "encounter_filter_obs_concept_list": "${concept_list}",
      "location_list": "${location_list}",
      "src_encounter_type_id": "${src_encounter_type_id}",
      "dst_encounter_type_id": "${dst_encounter_type_id}",
      "visit_type_id": "${visit_type_id}",
      "program_id": "${program_id}",
      "dst_location_id": "${dst_location_id}",
      "ignore_patient_id": true,
      "ignore_location_list": false,
      "ignore_src_encounter_type_id": false,
      "ignore_encounter_filter_obs_concept_list": false,
      "limitToOneResult": false,
      "extra_condition": "${extra_condition}"
    }
  },
  "parameters": [
    "aliases_prefix",
    "concept_list",
    "location_list",
    "src_encounter_type_id",
    "dst_encounter_type_id",
    "visit_type_id",
    "program_id",
    "dst_location_id",
    "order_type_id",
    "extra_condition"
  ],
  "template": {
    "childItemConf": [
      {
        "srcConf": {
          "tableName": "obs",
          "tableAlias": "${aliases_prefix}_order_obs_src_ds",
          "joinExtraCondition": "concept_id in (${concept_list}) and voided = 0",
          "extraObjectDataSource": [
            {
              "name": "${aliases_prefix}_transformed_order_obs_src_ds",
              "objectFields": [
                {
                  "name": "concept_id",
                  "relationshipResolutionStrategy": "SKIP",
                  "transformer": "MAPPING_TRANSFORMER(sesp_sisrme_metadata_mapping,sesp_value,sisrme_value,on_missing:USE_INPUT,input:COALESCE_TRANSFORMER(${aliases_prefix}_order_obs_src_ds.value_coded,${aliases_prefix}_order_obs_src_ds.concept_id), extra_condition:mapping_group=\"concept\")",
                  "dataType": "int"
                }
              ]
            }
          ]
        },
        "dstConf": [
          {
            "onConflict": "UPDATE_EXISTING",
            "template": {
              "name": "order_DstConf",
              "parameters": {
                "aliases_prefix": "${aliases_prefix}",
                "patient_id": "${aliases_prefix}_encounter_dst_ds.patient_id",
                "location_id": "${aliases_prefix}_encounter_dst_ds.location_id",
                "orderer": "${aliases_prefix}_encounter_provider_src_ds.provider_id",
                "concept_id": "${aliases_prefix}_transformed_order_obs_src_ds.concept_id",
                "value_text": "${aliases_prefix}_order_obs_src_ds.value_text",
                "order_type_id": "${order_type_id}",
                "dst_order_encounter_type_id": "${dst_encounter_type_id}",
                "visit_type_id": "${visit_type_id}",
                "program_id": "${program_id}",
                "order_date": "${aliases_prefix}_order_obs_src_ds.obs_datetime",
                "creator": "${aliases_prefix}_encounter_dst_ds.creator"
              }
            }
          }
        ],
        "childItemConf": [
          {
            "srcConf": {
              "tableName": "obs",
              "tableAlias": "${aliases_prefix}_test_order_src_obs_ds",
              "joinFields": [
                {
                  "srcField": "obs_id",
                  "dstField": "obs_id"
                }
              ]
            },
            "dstConf": [
              {
                "tableName": "test_order",
                "onConflict": "UPDATE_EXISTING",
                "preferredDataSource": [
                  "${aliases_prefix}_test_order_src_obs_ds"
                ],
                "ignorableFields": [
                  "specimen_source",
                  "laterality",
                  "clinical_history",
                  "frequency",
                  "number_of_repeats",
                  "orders_id",
                  "obs_group_id"
                ],
                "mapping": [
                  {
                    "srcField": "${aliases_prefix}_orders_dst_ds.order_id",
                    "dstField": "order_id"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
