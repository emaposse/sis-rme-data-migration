{
  "name": "src_obs_joined_with_grouping_obs",
  "parameters": [
    "concept_list",
    "aliases_prefix"
  ],
  "template": {
    "tableName": "obs",
    "tableAlias": "${aliases_prefix}_obs_src_ds",
    "joinExtraCondition": "concept_id in (${concept_list}) and voided = 0",
    "joinFields": [
      {
        "srcField": "obs_group_id",
        "dstField": "obs_id"
      }
    ]
  }
}
