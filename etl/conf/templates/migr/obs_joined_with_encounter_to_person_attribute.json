{
  "name": "obs_joined_with_encounter_to_person_attribute",
  "parameters": [
    "aliases_prefix",
    "src_encounter_type_id",
    "concept_list",
    "location_list",
    "person_attribute_type_id",
    "value_field",
    "value_field_is_date",
    "transformer",
    "extra_condition"
  ],
  "template": {
    "srcConf": {
      "tableName": "obs",
      "tableAlias": "${aliases_prefix}_obs_src_ds",
      "extraConditionForExtract": "concept_id in (${concept_list}) and voided=0 and ${extra_condition}",
      "auxExtractTable": [
        {
          "tableName": "encounter",
          "tableAlias": "${aliases_prefix}_aux_extract_encounter_within_obs_src_ds",
          "joinExtraCondition": "${aliases_prefix}_aux_extract_encounter_within_obs_src_ds.encounter_type = ${src_encounter_type_id} and ${aliases_prefix}_aux_extract_encounter_within_obs_src_ds.location_id in (${location_list}) and  ${aliases_prefix}_aux_extract_encounter_within_obs_src_ds.voided=0",
          "joinType": "INNER"
        }
      ]
    },
    "dstConf": [
      {
        "tableName": "person_attribute",
        "tableAlias": "${aliases_prefix}_person_attribute_dst_ds",
        "onConflict": "UPDATE_EXISTING",
        "allowDuplicateDestinationMappings": true,
        "mapping": [
          {
            "srcValue": "${person_attribute_type_id}",
            "dstField": "person_attribute_type_id",
            "relationshipResolutionStrategy": "VALIDATE_ONLY"
          },
          {
            "srcField": "${value_field}",
            "dstField": "value",
            "transformer": "${transformer}"
          },
          {
            "dstField": "uuid",
            "transformer": "UUID_ON_DEMAND_TRANSFORMER(table_name:person_attribute,lookup_condition:person_attribute_type_id=${person_attribute_type_id} and person_id = ${aliases_prefix}_obs_src_ds.person_id and value = ${value_field})",
            "applyCondition": "${value_field_is_date} = false"
          },
          {
            "dstField": "uuid",
            "transformer": "UUID_ON_DEMAND_TRANSFORMER(table_name:person_attribute,lookup_condition:person_attribute_type_id=${person_attribute_type_id} and person_id = ${aliases_prefix}_obs_src_ds.person_id and date(value) = date(${value_field}))",
            "applyCondition": "${value_field_is_date} = true"
          }
        ],
        "ignorableFields": [
          "changed_by",
          "date_changed"
        ]
      }
    ]
  }
}
