{
  "name": "closest_previous_lab_order_request",
  "parameters": [
    "aliases_prefix",
    "orderer",
    "order_type_id",
    "creator",
    "location_id",
    "dst_order_encounter_type_id",
    "visit_type_id",
    "program_id"
  ],
  "template": {
    "srcConf": {
      "tableName": "obs",
      "tableAlias": "${aliases_prefix}_result_obs_src_ds",
      "joinFields": [
        {
          "srcField": "obs_id",
          "dstField": "obs_id"
        }
      ],
      "extraQueryDataSource": [
        {
          "name": "${aliases_prefix}_order_obs_src_ds",
          "script": "closest_order_request.sql",
          "required": true,
          "dynamicElements": [
            "${aliases_prefix}_result_obs_src_ds.obs_id"
          ],
          "applyCondition": "${aliases_prefix}_result_obs_src_ds.value_coded != 165361"
        },
        {
          "name": "${aliases_prefix}_order_obs_src_ds",
          "script": "closest_cd4_order_request.sql",
          "required": true,
          "dynamicElements": [
            "${aliases_prefix}_result_obs_src_ds.obs_id"
          ],
          "applyCondition": "${aliases_prefix}_result_obs_src_ds.value_coded = 165361"
        }
      ]
    },
    "dstConf": [
      {
        "onConflict": "UPDATE_EXISTING",
        "template": {
          "name": "order_DstConf",
          "parameters": {
            "aliases_prefix": "${aliases_prefix}",
            "patient_id": "${aliases_prefix}_result_obs_src_ds.person_id",
            "location_id": "${location_id}",
            "orderer": "${orderer}",
            "concept_id": "${aliases_prefix}_order_obs_src_ds.value_coded",
            "value_text": "NULL_VALUE_TRANSFORMER()",
            "order_type_id": "${order_type_id}",
            "dst_order_encounter_type_id": "${dst_order_encounter_type_id}",
            "visit_type_id": "${visit_type_id}",
            "program_id": "${program_id}",
            "order_date": "${aliases_prefix}_order_obs_src_ds.obs_datetime",
            "creator": "${creator}"
          }
        }
      }
    ],
    "childItemConf": [
      {
        "srcConf": {
          "tableName": "obs",
          "tableAlias": "${aliases_prefix}_test_order_src_obs_ds",
          "joinFields": [
            {
              "srcField": "obs_id",
              "dstField": "obs_id"
            }
          ]
        },
        "dstConf": [
          {
            "tableName": "test_order",
            "tableAlias": "${aliases_prefix}_test_order_dst_ds",
            "preferredDataSource": [
              "${aliases_prefix}_test_order_src_obs_ds"
            ],
            "ignorableFields": [
              "specimen_source",
              "laterality",
              "clinical_history",
              "frequency",
              "number_of_repeats",
              "orders_id",
              "obs_group_id"
            ],
            "mapping": [
              {
                "srcField": "${aliases_prefix}_orders_dst_ds.order_id",
                "dstField": "order_id"
              }
            ]
          }
        ]
      }
    ]
  }
}
