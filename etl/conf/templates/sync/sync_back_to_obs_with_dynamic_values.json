{
  "name": "sync_back_to_obs_with_dynamic_values",
  "extends": {
    "name": "sync_back_to_obs",
    "parameters": {
      "filter_condition": "${filter_condition}",
      "src_aliases_prefix": "${src_aliases_prefix}",
      "dst_aliases_prefix": "${dst_aliases_prefix}",
      "encounter_type_id": "${encounter_type_id}",
      "obs_group_id_transformer": "${obs_group_id_transformer}"
    },
    "override": [
      {
        "path": "mapping",
        "type": "UPDATE_ON_LIST",
        "match": {
          "dstField": "value_coded"
        },
        "value": {
          "srcField": "${value_coded}",
          "dstField": "value_coded"
        }
      },
      {
        "path": "mapping",
        "type": "UPDATE_ON_LIST",
        "match": {
          "dstField": "obs_datetime"
        },
        "value": {
          "srcField": "${obs_datetime}",
          "dstField": "obs_datetime"
        }
      },
      {
        "path": "mapping",
        "type": "UPDATE_ON_LIST",
        "match": {
          "dstField": "concept_id"
        },
        "value": {
          "srcField": "${concept_id}",
          "dstField": "concept_id"
        }
      }
    ]
  },
  "parameters": [
    "filter_condition",
    "src_aliases_prefix",
    "dst_aliases_prefix",
    "encounter_type_id",
    "obs_group_id_transformer",
    "concept_id",
    "value_coded",
    "obs_datetime"
  ]
}
