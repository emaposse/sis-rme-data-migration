{
  "name": "sync_dst_obs",
  "parameters": [
    "filter_condition",
    "src_aliases_prefix",
    "src_patient_uuid",
    "dst_aliases_prefix",
    "concept_id",
    "value_field",
    "value",
    "obs_datetime",
    "date_created",
    "location_id",
    "encounter_type_id",
    "obs_group_id_transformer",
    "voided",
    "date_voided",
    "void_reason",
    "uuid"
  ],
  "template": {
    "tableName": "obs",
    "tableAlias": "${dst_aliases_prefix}_obs_dst_ds",
    "onConflict": "UPDATE_EXISTING",
    "applyCondition": "${filter_condition}",
    "ignoreNoDstIssue": true,
    "useAsDataSource": true,
    "mappingResolutionStrategy": "MANUAL_ONLY",
    "unmappedFieldBehavior": "IGNORE",
    "allowDuplicateDestinationMappings": true,
    "ignorableFields": [
      "accession_number",
      "value_group_id",
      "value_coded_name_id",
      "value_modifier",
      "value_complex",
      "previous_version",
      "form_namespace_and_path",
      "interpretation",
      "order_group_id",
      "order_id"
    ],
    "preferredDataSource": [
      "${src_aliases_prefix}_src_ds"
    ],
    "mapping": [
      {
        "template": {
          "name": "dst_user_mapped_to_user_placeholder",
          "parameters": {
            "dst_user_field": "voided_by",
            "src_user_uuid": "${src_aliases_prefix}_voided_by_src_ds.uuid",
            "src_username": "${src_aliases_prefix}_voided_by_src_ds.username",
            "apply_condition": "${voided} = 1"
          }
        }
      },
      {
        "srcField": "${voided}",
        "dstField": "voided",
        "nullValueBehavior": "IGNORE"
      },
      {
        "srcField": "${void_reason}",
        "dstField": "void_reason",
        "nullValueBehavior": "IGNORE"
      },
      {
        "srcField": "${date_voided}",
        "dstField": "date_voided",
        "nullValueBehavior": "IGNORE"
      },
      {
        "dstField": "concept_id",
        "transformer": "MAPPING_TRANSFORMER(sesp_sisrme_metadata_mapping,sisrme_value,sesp_value,on_missing:USE_INPUT,input:${concept_id},extra_condition:mapping_group=\"concept\")"
      },
      {
        "srcValue": "${value}",
        "dstField": "${value_field}",
        "incompleteMappingBehavior": "DISCARD_MAPPING"
      },
      {
        "srcField": "${obs_datetime}",
        "dstField": "obs_datetime"
      },
      {
        "srcField": "${date_created}",
        "dstField": "date_created"
      },
      {
        "srcField": "${location_id}",
        "dstField": "location_id"
      },
      {
        "srcValue": "FINAL",
        "dstField": "status"
      },
      {
        "template": {
          "name": "dst_patient_mapped_to_patient_placeholder",
          "parameters": {
            "dst_patient_field": "person_id",
            "src_patient_uuid": "${src_patient_uuid}"
          }
        }
      },
      {
        "template": {
          "name": "dst_encounter_mapped_to_encounter_placeholder",
          "parameters": {
            "dst_encounter_field": "encounter_id",
            "dst_patient_id": "${dst_aliases_prefix}_obs_dst_ds.person_id",
            "dst_encounter_type_id": "${encounter_type_id}",
            "encounter_datetime": "DATE_TRANSFORMER(input:${obs_datetime},operation:START_OF_DAY)",
            "uuid": "UUID_ON_DEMAND_TRANSFORMER(table_name:encounter,lookup_condition:encounter_type=${encounter_type_id} and patient_id = ${dst_aliases_prefix}_obs_dst_ds.person_id and date(encounter_datetime) = date(${obs_datetime}))"
          }
        },
        "applyCondition": "${encounter_type_id} != 53"
      },
      {
        "template": {
          "name": "dst_encounter_mapped_to_encounter_placeholder",
          "parameters": {
            "dst_encounter_field": "encounter_id",
            "dst_patient_id": "${dst_aliases_prefix}_obs_dst_ds.person_id",
            "dst_encounter_type_id": "${encounter_type_id}",
            "encounter_datetime": "DATE_TRANSFORMER(input:${obs_datetime},operation:START_OF_DAY)",
            "uuid": "UUID_ON_DEMAND_TRANSFORMER(table_name:encounter,lookup_condition:encounter_type=${encounter_type_id} and patient_id = ${dst_aliases_prefix}_obs_dst_ds.person_id)"
          }
        },
        "applyCondition": "${encounter_type_id} = 53"
      },
      {
          "template": {
            "name": "dst_user_mapped_to_user_placeholder",
            "parameters": {
              "dst_user_field": "creator",
              "src_user_uuid": "${src_aliases_prefix}_creator_src_ds.uuid",
              "src_username": "${src_aliases_prefix}_creator_src_ds.username",
              "apply_condition": "ETL_CONF_CHECK(conf_name:${src_aliases_prefix}_creator_src_ds,operation:EXISTS)"
            }
          }
      },
      {
        "srcValue":"@defaultUserId",
        "dstField": "creator",
        "relationshipResolutionStrategy":"VALIDATE_ONLY",
        "applyCondition": "ETL_CONF_CHECK(conf_name:${src_aliases_prefix}_creator_src_ds,operation:DOES_NOT_EXIST)"        
      },      
      {
        "transformer": "${obs_group_id_transformer}",
        "dstField": "obs_group_id",
        "nullValueBehavior": "IGNORE"
      },
      {
        "srcValue": "Sync SIS-RME -> SESP",
        "dstField": "comments",
        "applyCondition": "ETL_CONF_CHECK(conf_name:${dst_aliases_prefix}_obs_dst_ds,operation:HAS_FIELD,field:comments)"
      },
      {
        "srcValue": "${uuid}",
        "dstField": "uuid"
      }
    ]
  }
}
