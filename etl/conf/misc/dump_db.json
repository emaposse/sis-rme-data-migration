{
  "originAppLocationCode": "${location_name}",
  "etlRootDirectory": "${etl_root_dir}",
  "syncStageSchema": "migration_data_dump_stage_area",
  "templatesDir": "templates/migr/*.json",
  "mainConnInfo": {
    "dataBaseUserName": "${srcUserName}",
    "dataBaseUserPassword": "${srcUserPassword}",
    "connectionURI": "${srcConnectionURI}",
    "driveClassName": "${driveClassName}",
    "isolationLevel": "${connectionIsolationLevel}"
  },
  "srcConnInfo": {
    "dataBaseUserName": "${srcUserName}",
    "dataBaseUserPassword": "${srcUserPassword}",
    "connectionURI": "${srcConnectionURI}",
    "driveClassName": "${driveClassName}",
    "isolationLevel": "${connectionIsolationLevel}",
    "maxActiveConnections": "${maxActiveConnections}",
    "maxIdleConnections": "${maxIdleConnections}",
    "minIdleConnections": "${minIdleConnections}"
  },
  "dstConnInfo": {
    "dataBaseUserName": "${dstUserName}",
    "dataBaseUserPassword": "${dstUserPassword}",
    "connectionURI": "${dstConnectionURI}",
    "driveClassName": "${driveClassName}",
    "databaseSchemaPath": "sis-rme-empty-db.sql",
    "isolationLevel": "${connectionIsolationLevel}",
    "maxActiveConnections": "${maxActiveConnections}",
    "maxIdleConnections": "${maxIdleConnections}",
    "minIdleConnections": "${minIdleConnections}"
  },
  "dataModel": {
    "databaseObjectInstantiationMode": "PRECOMPILED_POJO_WITH_FALLBACK",
    "schemaMetadataMode": "PRECOMPILED_WITH_FALLBACK",
    "srcPojoPackageName": "openmrs_2_6.sisrme",
    "dstPojoPackageName": "openmrs_2_6.sisrme",
    "srcSchema": "${src_db}",
    "dstSchema": "${dst_db}",
    "overrideExistingDataModelElement": "${overrideExistingDataModelElement}",
    "autoGenerateDataModelForParents": "${autoGenerateDataModelForParents}",
    "javaFormatterConfigurationFile": "conf/formatter/eclipse-java-formatter.xml",
    "binPojoDirectory": "${binPojoDirectory}",
    "srcPojoDirectory": "${srcPojoDirectory}",
    "srcDataModelId": "openmrs_2_6_sisrme",
    "dstDataModelId": "openmrs_2_6_sisrme",
    "classPath": [
      "${etl_root_dir}/app/sisrme-etl-api-1.0.jar",
      "${etl_root_dir}/${binPojoDirectory}"
    ]
  },
  "ignoreAllStartupScripts": "${ignoreAllStartupScripts}",
  "operations": [
    {
      "identifier": "sync-processor",
      "operationType": "ETL",
      "processingBatch": "${processingBatch}",
      "processingMode": "SERIAL",
      "parallelProcessingStrategy": "${parallelProcessingStrategy}",
      "disableMultithreadingSearch": "${disableMultithreadingSearch}",
      "useMysqlInsertIgnore": false,
      "useSharedConnectionPerThread": false,
      "finishOnNoRemainRecordsToProcess": true,
      "skipFinalDataVerification": true,
      "maxSupportedProcessors": "${maxSupportedProcessors}",
      "totalCountStrategy": "COUNT_ONCE",
      "mustRestartInTheEnd": false,
      "disabled": false,
      "doNotWriteOperationHistory": true,
      "doNotProcessSkippedRecords": false
    }
  ],
  "defaultExceptionBehavior": "ABORT_PROCESS",
  "defaultInconsistencyBehavior": "ABORT_PROCESS",
  "disableDefaultObjectCreation": true,
  "relationshipResolutionStrategy": "RESOLVE",
  "relatedEtlSrcTables": [
    "person",
    "patient",
    "users",
    "provider",
    "location"
  ],
  "params": {
    "dst_db": "${dst_db}"
  },
  "etlItemConfiguration": [
    {
      "srcConf": {
        "tableName": "users",
        "tableAlias": "user_src_ds",
        "extraConditionForExtract": "not exists (select 1 from ${dst_db}.users dst_user where user_src_ds.uuid = dst_user.uuid)",
        "onConflict": "UPDATE_EXISTING",
        "parents": [
          {
            "tableName": "person",
            "defaultValueDueInconsistency": 1
          },
          {
            "tableName": "users",
            "defaultValueDueInconsistency": 1
          }
        ],
        "removeForbidden": true,
        "observationDateFields": [
          "date_changed",
          "date_retired"
        ],
        "extraObjectDataSource": [
          {
            "name": "default_values",
            "objectFields": [
              {
                "name": "retired",
                "value": "@retired",
                "dataType": "boolean",
                "overrideTriggerValue": false,
                "defaultValue": true
              },
              {
                "name": "retired_by",
                "value": "@retired_by",
                "defaultValue": "1",
                "dataType": "int"
              },
              {
                "name": "date_retired",
                "value": "@date_retired",
                "defaultValue": "2026-02-25 14:00",
                "dataType": "date"
              },
              {
                "name": "retire_reason",
                "value": "@retire_reason",
                "defaultValue": "Sesp Migrated User",
                "dataType": "string"
              }
            ]
          }
        ]
      },
      "dstConf": [
        {
          "tableName": "users",
          "ignorableFields": [
            "creator_id",
            "activation_key"
          ],
          "preferredDataSource": [
            "default_values"
          ],
          "parents": [
            {
              "tableName": "users",
              "defaultValueDueInconsistency": 1
            }
          ]
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "person",
        "tableAlias": "person_src_ds",
        "extraConditionForExtract": "not exists (select 1 from ${dst_db}.person dst_person where person_src_ds.uuid = dst_person.uuid)"
      },
      "dstConf": [
        {
          "tableName": "person",
          "tableAlias": "person_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "person_address",
        "tableAlias": "person_address_src_ds",
        "extraConditionForExtract": "person_address_src_ds.person_id > 20418"
      },
      "dstConf": [
        {
          "tableName": "person_address",
          "tableAlias": "person_address_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "person_complex_attribute",
        "tableAlias": "person_complex_attribute_src_ds",
        "extraConditionForExtract": "person_complex_attribute_src_ds.person_complex_attribute_id > 15243"
      },
      "dstConf": [
        {
          "tableName": "person_complex_attribute",
          "tableAlias": "person_complex_attribute_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "person_attribute",
        "tableAlias": "person_attribute_src_ds",
        "extraConditionForExtract": "person_attribute_src_ds.person_attribute_id > 89089"
      },
      "dstConf": [
        {
          "tableName": "person_attribute",
          "tableAlias": "person_attribute_dst_ds",
          "parents": [
            {
              "tableName": "person_complex_attribute",
              "refMapping": [
                {
                  "childFieldName": "value",
                  "parentFieldName": "person_complex_attribute_id"
                }
              ],
              "conditionalFields": [
                {
                  "name": "person_attribute_type_id",
                  "value": "78, 91, 92, 101, 102, 103, 105, 107, 109, 110, 112, 114, 115, 116, 117"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "person_complex_attribute_detail",
        "tableAlias": "person_complex_attribute_detail_src_ds",
        "extraConditionForExtract": "person_complex_attribute_detail_src_ds.person_complex_attribute_detail_id > 53114"
      },
      "dstConf": [
        {
          "tableName": "person_complex_attribute_detail",
          "tableAlias": "person_complex_attribute_detail_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "person_name",
        "tableAlias": "person_name_src_ds",
        "extraConditionForExtract": "person_name_src_ds.person_id > 20418"
      },
      "dstConf": [
        {
          "tableName": "person_name",
          "tableAlias": "person_name_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "patient",
        "tableAlias": "patient_src_ds",
        "extraConditionForExtract": "not exists (select 1 from ${dst_db}.person dst_person inner join  person src_person on src_person.uuid = dst_person.uuid inner join ${dst_db}.patient dst_patient on dst_patient.patient_id =  dst_person.person_id where src_person.person_id =  patient_src_ds.patient_id)"
      },
      "dstConf": [
        {
          "tableName": "patient",
          "tableAlias": "patient_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "patient_identifier",
        "tableAlias": "patient_identifier_src_ds",
        "extraConditionForExtract": "patient_identifier_src_ds.patient_id > 20418"
      },
      "dstConf": [
        {
          "tableName": "patient_identifier",
          "tableAlias": "patient_identifier_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "patient_program",
        "tableAlias": "patient_program_src_ds",
        "extraConditionForExtract": "patient_program_src_ds.patient_id > 20418"
      },
      "dstConf": [
        {
          "tableName": "patient_program",
          "tableAlias": "patient_program_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "patient_state",
        "tableAlias": "patient_state_src_ds",
        "extraConditionForExtract": "exists (select 1 from patient_program parent_patient_program where parent_patient_program.patient_program_id = patient_state_src_ds.patient_program_id and parent_patient_program.patient_id > 20418)"
      },
      "dstConf": [
        {
          "tableName": "patient_state",
          "tableAlias": "patient_state_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "visit",
        "tableAlias": "visit_src_ds",
        "extraConditionForExtract": "exists (select * from encounter encounter_src_ds where encounter_src_ds.encounter_id > 311026  and visit_src_ds.visit_id = encounter_src_ds.visit_id)"
      },
      "dstConf": [
        {
          "tableName": "visit",
          "tableAlias": "visit_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "visit",
        "tableAlias": "missing_visit_src_ds",
        "extraConditionForExtract": "exists (select * from migration_data_dump_stage_area.record_with_default_parents missing where missing.parent_table = 'visit' and missing.src_rec_id = missing_visit_src_ds.visit_id)"
      },
      "dstConf": [
        {
          "tableName": "visit",
          "tableAlias": "missing_visit_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "encounter",
        "tableAlias": "encounter_src_ds",
        "extraConditionForExtract": "encounter_src_ds.encounter_id > 311026"
      },
      "dstConf": [
        {
          "tableName": "encounter",
          "tableAlias": "encounter_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "encounter_program",
        "tableAlias": "encounter_program_src_ds",
        "extraConditionForExtract": "encounter_program_src_ds.encounter_id > 311026"
      },
      "dstConf": [
        {
          "tableName": "encounter_program",
          "tableAlias": "encounter_program_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "encounter_provider",
        "tableAlias": "encounter_provider_src_ds",
        "extraConditionForExtract": "encounter_provider_src_ds.encounter_id > 311026"
      },
      "dstConf": [
        {
          "tableName": "encounter_provider",
