        "extraConditionForExtract": "exists (select 1 from orders encounter_orders where encounter_orders.order_id = drug_order_src_ds.orders_id and encounter_orders.encounter_id > 311026)"
      },
      "dstConf": [
        {
          "tableName": "drug_order",
          "tableAlias": "drug_order_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "test_order",
        "tableAlias": "test_order_src_ds",
        "extraConditionForExtract": "exists (select 1 from orders encounter_orders where encounter_orders.order_id = test_order_src_ds.orders_id and encounter_orders.encounter_id > 311026)"
