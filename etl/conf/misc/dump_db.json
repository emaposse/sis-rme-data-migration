        }
      ]
    },
    {
      "srcConf": {
        "tableName": "vital_signs",
        "tableAlias": "vital_signs_src_ds",
        "extraConditionForExtract": "vital_signs_src_ds.vital_signs_id > 4708"
      },
      "dstConf": [
        {
          "tableName": "vital_signs",
          "tableAlias": "vital_signs_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "conditions",
        "tableAlias": "conditions_src_ds",
        "extraConditionForExtract": "conditions_src_ds.condition_id > 22619"
      },
      "dstConf": [
        {
          "tableName": "conditions",
          "tableAlias": "conditions_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "encounter_diagnosis",
        "tableAlias": "encounter_diagnosis_src_ds",
        "extraConditionForExtract": "encounter_diagnosis_src_ds.condition_id > 22419"
      },
      "dstConf": [
        {
          "tableName": "encounter_diagnosis",
          "tableAlias": "encounter_diagnosis_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "order_group",
        "tableAlias": "order_group_src_ds",
        "extraConditionForExtract": "order_group_src_ds.encounter_id > 311026"
      },
      "dstConf": [
        {
          "tableName": "order_group",
          "tableAlias": "order_group_dst_ds",
          "onConflict": "KEEP_EXISTING"
        }
      ]
    },
    {
      "srcConf": {
