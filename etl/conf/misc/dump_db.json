      },
      "dstConf": [
        {
          "tableName": "pharmacy_package",
          "tableAlias": "pharmacy_package_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "pharmacy_packaged_drug",
        "tableAlias": "pharmacy_packaged_drug_src_ds",
        "extraConditionForExtract": "exists (select 1 from pharmacy_package encounter_package where encounter_package.pharmacy_package_id = pharmacy_packaged_drug_src_ds.pharmacy_package_id and encounter_package.prescription_encounter_id > 311026)"
      },
      "dstConf": [
        {
          "tableName": "pharmacy_packaged_drug",
          "tableAlias": "pharmacy_packaged_drug_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "appointment",
        "tableAlias": "appointment_src_ds",
        "extraConditionForExtract": "appointment_id > 16640",
        "ignorableFields": [
          "visit_id",
          "voided",
          "void_reason",
          "voided_by",
          "date_voided",
          "creator",
          "date_created",
          "uuid"
        ]
      },
      "dstConf": [
        {
          "tableName": "appointment",
          "tableAlias": "appointment_dst_ds",
          "unmappedFieldBehavior":"IGNORE",
          "mapping": [
            {
              "srcField": "created_at",
              "dstField": "date_created"
            },
            {
              "srcValue": "0",
              "dstField": "voided"
            },
            {
              "srcField": "1",
              "dstField": "creator"
            },
            {
              "dstField": "uuid",
              "transformer": "FAST_SQL_TRANSFORMER(select uuid())"
            }
          ]
        }
      ]
