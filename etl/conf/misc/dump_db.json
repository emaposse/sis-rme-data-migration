    {
      "srcConf": {
        "tableName": "pharmacy_batch",
        "tableAlias": "pharmacy_batch_src_ds",
        "extraConditionForExtract": "pharmacy_batch_src_ds.batch_id > 2183"
      },
      "dstConf": [
        {
          "tableName": "pharmacy_batch",
          "tableAlias": "pharmacy_batch_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "pharmacy_transaction",
        "tableAlias": "pharmacy_transaction_src_ds",
        "joinExtraCondition": "pharmacy_transaction_src_ds.pharmacy_transaction_id > 7414"
      },
      "dstConf": [
        {
          "tableName": "pharmacy_transaction",
          "tableAlias": "pharmacy_transaction_dst_ds"
        }
      ]
    },
    {
      "srcConf": {
        "tableName": "pharmacy_package",
        "tableAlias": "pharmacy_package_src_ds",
