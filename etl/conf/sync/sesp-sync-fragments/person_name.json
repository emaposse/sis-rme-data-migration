{
  "applyCondition": "table_name='person_name'",
  "srcConf": {
    "template": {
      "name": "sisrme_src_ds",
      "parameters": {
        "aliases_prefix": "person_name",
        "main_output_template_name": "person_name_ds_from_json"
      }
    },
    "excludedFieldsFromObjectDesc": [
      "entity_payload"
    ]
  },
  "dstConf": [
    {
      "tableName": "person_name",
      "onConflict": "UPDATE_EXISTING",
      "preferredDataSource": [
        "person_name_src_ds"
      ],
      "mapping": [
        {
          "template": {
            "name": "dst_person_mapped_to_person_placeholder",
            "parameters": {
              "dst_person_field": "person_id",
              "src_person_uuid": "person_name_person_src_ds.uuid"
            }
          }
        },
        {
          "template": {
            "name": "dst_user_mapped_to_user_placeholder",
            "parameters": {
              "dst_user_field": "creator",
              "src_user_uuid": "person_name_creator_src_ds.uuid",
              "src_username": "person_name_creator_src_ds.username",
              "apply_condition": ""
            }
          }
        },
        {
          "template": {
            "name": "dst_user_mapped_to_user_placeholder",
            "parameters": {
              "dst_user_field": "changed_by",
              "src_user_uuid": "person_name_changed_by_src_ds.uuid",
              "src_username": "person_name_changed_by_src_ds.username",
              "apply_condition": "person_name_src_ds.changed_by != null"
            }
          }
        },
        {
          "template": {
            "name": "dst_user_mapped_to_user_placeholder",
            "parameters": {
              "dst_user_field": "voided_by",
              "src_user_uuid": "person_name_voided_by_src_ds.uuid",
              "src_username": "person_name_voided_by_src_ds.username",
              "apply_condition": "person_name_src_ds.voided_by != null"
            }
          }
        }
      ]
    },
    {
      "template": {
        "name": "dst_index_update_staging",
        "parameters": {
          "resource_type": "person_name",
          "record_uuid": "person_name_src_ds.uuid"
        }
      }
    }       
  ]
}
