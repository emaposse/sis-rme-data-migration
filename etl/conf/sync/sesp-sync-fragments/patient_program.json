{
  "applyCondition": "table_name='patient_program'",
  "srcConf": {
    "template": {
      "name": "sisrme_src_ds",
      "parameters": {
        "aliases_prefix": "patient_program",
        "main_output_template_name": "patient_program_ds_from_json"
      }
    },
    "excludedFieldsFromObjectDesc": [
      "entity_payload"
    ]
  },
  "dstConf": [
    {
      "tableName": "patient_program",
      "onConflict": "UPDATE_EXISTING",
      "allowDuplicateDestinationMappings": true,
      "applyCondition": "patient_program_src_ds.program_id in (1,2,3,4,5,30,6,7,28,8,6,29,9,25)",
