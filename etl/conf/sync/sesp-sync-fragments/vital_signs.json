{
  "applyCondition": "table_name='vital_signs'",
  "srcConf": {
    "template": {
      "name": "sisrme_src_ds",
      "parameters": {
        "aliases_prefix": "vital_signs",
        "main_output_template_name": "vital_signs_ds_from_json"
      }
    },
    "excludedFieldsFromObjectDesc": [
      "entity_payload"
    ]
  },
  "dstConf": [
    {
      "template": {
        "name": "sync_dst_obs",
        "parameters": {
          "src_aliases_prefix": "vital_signs",
          "src_patient_uuid": "vital_signs_patient_src_ds.uuid",
          "dst_aliases_prefix": "blood_pressure_systolic_vital_signs",
          "concept_id": "5085",
          "value_field": "value_numeric",
          "value": "vital_signs_src_ds.blood_pressure_systolic",
          "obs_datetime": "vital_signs_src_ds.date_created",
          "date_created": "vital_signs_src_ds.date_created",
          "voided": "vital_signs_src_ds.voided",
          "void_reason": "vital_signs_src_ds.void_reason",
          "uuid": "COALESCE_TRANSFORMER(FAST_SQL_TRANSFORMER(query:select uuid from ${dst_db}.obs exists_obs WHERE exists_obs.concept_id = blood_pressure_systolic_vital_signs_obs_dst_ds.concept_id and  blood_pressure_systolic_vital_signs_obs_dst_ds.encounter_id = exists_obs.encounter_id LIMIT 1,onNullTransformedValue:SET_TO_NULL), FAST_SQL_TRANSFORMER(select uuid()) )",
          "location_id": "vital_signs_location_dst_ds.location_id",
          "encounter_type_id": "6",
          "filter_condition": "vital_signs_src_ds.blood_pressure_systolic != null",
          "obs_group_id_transformer": "NULL_VALUE_TRANSFORMER()",
          "date_voided": "vital_signs_src_ds.date_voided"
        }
      }
    },
    {
      "template": {
        "name": "sync_dst_obs",
        "parameters": {
          "src_aliases_prefix": "vital_signs",
          "src_patient_uuid": "vital_signs_patient_src_ds.uuid",
          "dst_aliases_prefix": "blood_pressure_diastolic_vital_signs",
          "concept_id": "5086",
          "value_field": "value_numeric",
          "value": "vital_signs_src_ds.blood_pressure_diastolic",
          "obs_datetime": "vital_signs_src_ds.date_created",
          "date_created": "vital_signs_src_ds.date_created",
          "voided": "vital_signs_src_ds.voided",
          "void_reason": "vital_signs_src_ds.void_reason",
          "uuid": "COALESCE_TRANSFORMER(FAST_SQL_TRANSFORMER(query:select uuid from ${dst_db}.obs exists_obs WHERE exists_obs.concept_id = blood_pressure_diastolic_vital_signs_obs_dst_ds.concept_id and  blood_pressure_diastolic_vital_signs_obs_dst_ds.encounter_id = exists_obs.encounter_id LIMIT 1,onNullTransformedValue:SET_TO_NULL), FAST_SQL_TRANSFORMER(select uuid()) )",
          "location_id": "vital_signs_location_dst_ds.location_id",
          "encounter_type_id": "6",
          "filter_condition": "vital_signs_src_ds.blood_pressure_diastolic != null",
          "obs_group_id_transformer": "NULL_VALUE_TRANSFORMER()",
          "date_voided": "vital_signs_src_ds.date_voided"
        }
      }
    }
  ]
}
